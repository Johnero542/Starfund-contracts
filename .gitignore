# Build artifacts
/target/
target_local/
**/*.rs.bk

# Root Cargo.lock is intentionally tracked for reproducible builds.
.cargo/

# Local command outputs (generated)
build_output*.txt
test_output*.txt

# Local notes / PR scratch files
PR_DESCRIPTION.md
TODO.md

# Test snapshots (generated by insta, cargo-nextest, and similar frameworks)
**/test_snapshots/
**/__snapshots__/
**/*.snap
**/*.snap.new

# Proptest: regression seeds are intentionally tracked for reproducible CI.
# Do NOT add escrow/proptest-regressions/ here.

# Node / JS (docs tooling)
node_modules/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Scratch / captured output (do not recreate at repo root)
*.exe
*.pdb
ci_logs*.txt
ci_main.txt
out.txt
test_out*.log
commit_msg.txt
ghit-*.md

# Kiro agent working files
.kiro/agents/

# WASM build output (large binary; reproducible from source)
**/*.wasm
